[server]
protocol = http
http_addr = 0.0.0.0
http_port = 3000
domain = {{ grafana_domain }}
root_url = {{ grafana_root_url | regex_replace('/$', '') }}/
enforce_domain = false

[database]
type = postgres
host = {{ grafana_rds_host }}:{{ grafana_rds_port }}
name = {{ grafana_rds_database }}
user = {{ grafana_rds_user }}
password = {{ grafana_rds_password }}
ssl_mode = {{ grafana_rds_ssl_mode }}

[security]
admin_user = {{ grafana_admin_user }}
admin_password = {{ grafana_admin_password }}
disable_gravatar = true
cookie_secure = {{ 'false' if (grafana_root_url | regex_search('^https?://')) and (grafana_root_url is match('^http://')) else 'true' }}

[users]
allow_sign_up = false

[log]
mode = console
level = info

[unified_alerting]
enabled = true
