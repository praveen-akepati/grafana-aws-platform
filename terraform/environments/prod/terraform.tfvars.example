aws_region   = "ap-south-1"
project_name = "grafana-platform"
environment  = "prod"

# Production: custom domain + HTTPS (default).
use_custom_domain = true
domain_name       = "grafana.example.com"
hosted_zone_id    = "Z0123456789ABCDEFGHIJ"

# Set after: packer build -var region=ap-south-1
grafana_ami_id = "ami-0123456789abcdef0"

instance_type = "t3.medium"

# Restrict ALB to client office/VPN or known public IPs (CIDR notation).
allowed_ingress_cidrs = ["203.0.113.0/24"]

# Optional. Client Prometheus base URL — must be reachable from Grafana EC2 (see docs/client-prometheus-kubernetes.md).
prometheus_url = ""

# Production: false (RDS protection, backups, snapshots, destroy guardrails). Sandbox/POC: true.
poc_mode = false

# Optional override. When null, matches !poc_mode (on for production).
# enable_destroy_protection = true
