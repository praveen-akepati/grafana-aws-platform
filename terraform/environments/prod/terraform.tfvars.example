aws_region   = "ap-south-1"
project_name = "grafana-platform"
environment  = "prod"

# POC without a domain: ALB DNS + HTTP (no Route 53 / ACM).
use_custom_domain = false

# When use_custom_domain = true, set both:
# domain_name    = "grafana.example.com"
# hosted_zone_id = "Z0123456789ABCDEFGHIJ"

# Set after: packer build -var region=ap-south-1
grafana_ami_id = "ami-0123456789abcdef0"

instance_type = "t3.medium"

# Replace with your public IP /32 (e.g. from https://ifconfig.me) so only you can reach the ALB
allowed_ingress_cidrs = ["203.0.113.50/32"]

# POC: ngrok/cloudflared URL. Production client K8s: see docs/client-prometheus-kubernetes.md
prometheus_url = ""

# POC: true (easy destroy). Production on main branch: false
poc_mode = true

# Optional override. When null, matches !poc_mode (on for production).
# enable_destroy_protection = true

# Client VPN (recommended for private Prometheus). See docs/client-prometheus-kubernetes.md
# enable_client_vpn         = true
# customer_gateway_ip       = "203.0.113.10"
# customer_network_cidr     = "172.16.0.0/12"
